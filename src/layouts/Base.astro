---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	/** set false for full-bleed pages that replace the site header/footer with their own UI */
	chrome?: boolean;
}

const {
	title = `${SITE_TITLE}`,
	description = SITE_DESCRIPTION,
	chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<!-- theme before first paint: stored preference wins, default is dark -->
		<script is:inline>
			(() => {
				try {
					if (localStorage.getItem('theme') === 'light') {
						document.documentElement.dataset.theme = 'light';
					}
				} catch {}
			})();
		</script>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		{chrome && <Header />}
		<main class:list={['shell', { 'shell--bleed': !chrome }]}>
			<slot />
		</main>
		{chrome && <Footer />}
		<SearchModal />
	</body>
</html>
