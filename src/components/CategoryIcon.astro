---
import { categoryMeta } from '../lib/category-meta';

interface Props {
	category: string;
	/** CSS size of the square badge (default fits card/strip use) */
	size?: string;
}

const { category, size = '2.1rem' } = Astro.props;
const { color, svg } = categoryMeta(category);
---

<span class="cicon" style={`--cicon:${color};--cicon-size:${size}`} set:html={svg} />

<style>
	.cicon {
		display: inline-grid;
		place-items: center;
		width: var(--cicon-size);
		aspect-ratio: 1;
		flex: none;
		color: #fff;
	}
	.cicon :global(svg) {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>
