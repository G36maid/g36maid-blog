---
/**
 * rows / cards view switch for [data-post-list] containers.
 * The choice is stored in localStorage and applied site-wide.
 */
import { icon } from '../lib/icons';
---

<div class="view-toggle" role="group" aria-label="檢視模式切換">
	<button type="button" data-view-set="rows" aria-label="列模式" title="列模式" set:html={icon('rows')} />
	<button type="button" data-view-set="cards" aria-label="卡片模式" title="卡片模式" set:html={icon('grid')} />
</div>

<style>
	.view-toggle {
		flex: none;
		display: flex;
	}
	.view-toggle button {
		appearance: none;
		border-radius: 0;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.2rem;
		background: rgba(28, 36, 43, 0.85);
		border: 1px solid #414c55;
		color: var(--text);
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.view-toggle button + button {
		border-left: 0;
	}
	.view-toggle button :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
	}
	.view-toggle button.active {
		background: var(--blue);
		border-color: var(--blue);
		color: #fff;
	}
</style>

<script>
	const KEY = 'list-view';

	function applyView(view: string) {
		document.querySelectorAll<HTMLElement>('[data-post-list]').forEach((el) => {
			el.dataset.view = view;
		});
		document.querySelectorAll<HTMLButtonElement>('.view-toggle [data-view-set]').forEach((b) => {
			b.classList.toggle('active', b.dataset.viewSet === view);
		});
	}

	applyView(localStorage.getItem(KEY) ?? document.querySelector('[data-post-list]')?.getAttribute('data-view') ?? 'cards');

	document.querySelectorAll<HTMLButtonElement>('.view-toggle [data-view-set]').forEach((b) => {
		b.addEventListener('click', () => {
			const view = b.dataset.viewSet!;
			localStorage.setItem(KEY, view);
			applyView(view);
		});
	});
</script>
