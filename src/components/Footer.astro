---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell footer-row">
		<div>
			<div class="f-brand">G36<b>MAID</b> // WIRED ARCHIVE</div>
			<div class="f-slogan">Close the world, Open the nExt.</div>
			<div class="f-telemetry">
				<span class="status-dot" aria-hidden="true"></span>CONNECTED — LAYER:{year} · ASTRO 7 × MMDR × PAGEFIND
			</div>
			<div class="barcode" style="width: 9rem; margin-top: 0.6rem" aria-hidden="true"></div>
		</div>
		<div class="f-cols">
			<div class="f-col">
				<div class="f-head">Navigate</div>
				<a href="/blog/">Logs</a>
				<a href="/notes/">Notes</a>
				<a href="/tags/">Tags</a>
				<a href="/about/">About</a>
			</div>
			<div class="f-col">
				<div class="f-head">Connect</div>
				<a href="/rss.xml">RSS</a>
				<a href="/sitemap-index.xml">Sitemap</a>
				<a href="/">Home</a>
			</div>
			<div class="f-col">
				<div class="f-head">Legal</div>
				<div class="f-telemetry" style="max-width: 16rem; text-transform: none">© {year} G36MAID · 文章內容採 CC BY-SA 4.0 授權（除非另有標註）。</div>
			</div>
		</div>
	</div>
</footer>
