---
/** the four quick-link tiles: notes, tags, rss feed and the about card */
import { icon } from '../../lib/icons';
---

<div class="grid">
	<a class="tile" href="/notes/">
		<span class="tile-ic" set:html={icon('doc')} />
		<span class="tile-label">筆記</span>
		<span class="party" set:html={icon('party')} />
	</a>
	<a class="tile selected" href="/tags/">
		<span class="tile-ic" set:html={icon('tags')} />
		<span class="tile-label">標籤</span>
		<span class="party" set:html={icon('party')} />
	</a>
	<a class="tile" href="/rss.xml">
		<span class="tile-ic" set:html={icon('rss')} />
		<span class="tile-label">RSS 訂閱</span>
		<span class="party" set:html={icon('party')} />
	</a>
	<a class="tile secure" href="/about/">
		<span class="tile-ic" set:html={icon('person')} />
		<span class="tile-label">關於</span>
	</a>
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--gap);
	}
	.tile {
		position: relative;
		height: var(--tile-h);
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 14px;
		background: rgba(31, 39, 47, 0.88);
		border: 1px solid #39434c;
		color: #c3ccd3;
		text-decoration: none;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.tile:hover {
		border-color: #8f9ba4;
		background: rgba(40, 50, 60, 0.92);
	}
	.tile.selected {
		border: 2px solid #fff;
		color: #fff;
	}
	.tile-ic {
		width: 34px;
		height: 34px;
		flex: none;
		display: inline-grid;
		place-items: center;
	}
	.tile-ic :global(svg) {
		width: 100%;
		height: 100%;
	}
	.party {
		position: absolute;
		top: 7px;
		right: 8px;
		width: 14px;
		height: 14px;
		color: #7f8992;
	}
	.tile.secure {
		background: rgba(38, 52, 63, 0.9);
		color: #fff;
	}
	.tile-label {
		font-weight: 700;
		font-size: 17px;
		letter-spacing: 0.05em;
		color: inherit;
	}
	.tile.secure::after {
		content: '';
		position: absolute;
		top: 0;
		right: 0;
		border: 8px solid transparent;
		border-top-color: #45525c;
		border-right-color: #45525c;
	}

	@media (max-width: 960px), (max-aspect-ratio: 5/6) {
		.grid {
			grid-template-columns: 1fr 1fr;
			gap: 12px;
		}
		.tile {
			height: 84px;
		}
		.tile-ic {
			width: 32px;
			height: 32px;
		}
		.tile-label {
			font-size: 16px;
		}
	}
</style>
