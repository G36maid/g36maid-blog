---
/** homepage atmosphere: light shafts + slanted panels (pure CSS, no artwork) */
---

<div class="scene" aria-hidden="true">
	<i class="shard s1"></i>
	<i class="shard s2"></i>
	<i class="shard s3"></i>
	<i class="shaft f1"></i>
	<i class="shaft f2"></i>
</div>

<style>
	.scene {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			/* orange glow, top-right */
			radial-gradient(85% 120% at 88% -4%, rgba(217, 116, 30, 0.5), rgba(217, 116, 30, 0.12) 42%, transparent 66%),
			/* blue smoke, bottom-left */
			radial-gradient(58% 68% at 6% 104%, rgba(33, 112, 210, 0.5), transparent 62%),
			radial-gradient(46% 56% at 30% 112%, rgba(70, 145, 232, 0.3), transparent 60%),
			#0a0c0f;
	}
	.shard {
		position: absolute;
		top: -10%;
		height: 130%;
		transform: skewX(-7deg);
		background: linear-gradient(180deg, rgba(24, 29, 34, 0.72), rgba(12, 15, 18, 0.9));
		border-inline: 1px solid rgba(255, 255, 255, 0.04);
	}
	.s1 {
		left: 52%;
		width: 11%;
	}
	.s2 {
		left: 66%;
		width: 13%;
	}
	.s3 {
		left: 82%;
		width: 15%;
	}
	.shaft {
		position: absolute;
		top: -25%;
		height: 160%;
		transform: rotate(13deg);
		background: linear-gradient(90deg, transparent, rgba(255, 196, 130, 0.07) 45%, rgba(255, 196, 130, 0.13) 55%, transparent);
	}
	.f1 {
		left: 46%;
		width: 250px;
	}
	.f2 {
		left: 70%;
		width: 134px;
		opacity: 0.7;
	}

	@media (max-width: 960px), (max-aspect-ratio: 5/6) {
		.shard,
		.shaft {
			display: none;
		}
	}
</style>
