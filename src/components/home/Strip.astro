---
/** status strip under the top bar, linking to the latest post */
interface Props {
	href: string;
	title: string;
	date: string;
}
const { href, title, date } = Astro.props;
---

<a class="strip" {href}>
	<span class="strip-tag">LATEST OPERATION</span>
	{title} <time>— {date}</time>
</a>

<style>
	.strip {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.6em;
		height: 40px;
		padding: 0 12px 0 var(--inset);
		background: rgba(11, 13, 16, 0.82);
		border-block: 1px solid rgba(255, 255, 255, 0.05);
		color: #d8dde1;
		font-family: var(--font-body);
		font-size: 14px;
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.strip:hover {
		color: #fff;
	}
	.strip-tag {
		flex: none;
		font-family: var(--font-narrow);
		font-weight: 700;
		letter-spacing: 0.18em;
		font-size: 0.82em;
		color: #f5c518;
	}
	.strip time {
		color: #8b949c;
	}

	@media (max-width: 960px), (max-aspect-ratio: 5/6) {
		.strip {
			height: 36px;
			padding: 0 16px;
			font-size: 13px;
		}
	}
</style>
