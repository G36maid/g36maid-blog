---
/**
 * home content carousel — the R6 menu's rotating event panel.
 * Slides come from src/data/events.json (pinned, post id or custom link);
 * unfilled slots auto-fill with the latest posts. Auto-rotates every 6s,
 * arrows and dots for manual switching, pauses on hover, and respects
 * prefers-reduced-motion.
 */
import FormattedDate from '../FormattedDate.astro';
import { icon } from '../../lib/icons';
import { categoryLabel, postCover, type Post } from '../../lib/content';

interface Slide {
	href: string;
	title: string;
	image?: string;
	eyebrow: string;
	date?: Date;
}
interface Props {
	/** entries of the event collection (src/data/events.json) */
	events: { id: string; data: { post?: string; href?: string; title?: string; image?: string } }[];
	/** all posts, newest first — fills unpinned slots */
	posts: Post[];
}
const { events, posts } = Astro.props;

const byId = new Map(posts.map((p) => [p.id, p]));
type SlideOrNull = Slide | undefined;
const pinned = events
	.map((e): SlideOrNull => {
		const d = e.data;
		if (d.post) {
			const p = byId.get(d.post);
			if (!p) return undefined;
			return {
				href: `/blog/${p.id}/`,
				title: d.title ?? p.data.title,
				image: d.image ?? postCover(p),
				eyebrow: categoryLabel(p.data.category),
				date: p.data.pubDate,
			};
		}
		return d.href && d.title
			? { href: d.href, title: d.title, image: d.image, eyebrow: 'EVENT', date: undefined }
			: undefined;
	})
	.filter((s): s is Slide => !!s)
	.slice(0, 5);

for (const p of posts) {
	if (pinned.length >= 5) break;
	if (pinned.some((s) => s.href === `/blog/${p.id}/`)) continue;
	pinned.push({
		href: `/blog/${p.id}/`,
		title: p.data.title,
		image: postCover(p),
		eyebrow: categoryLabel(p.data.category),
		date: p.data.pubDate,
	});
}
const slides = pinned;
---

{
	slides.length > 0 && (
		<div class="carousel" data-carousel aria-roledescription="輪播">
			<div class="car-viewport">
				<div class="car-track">
					{slides.map((s, i) => (
						<a
							class:list={['car-slide', { active: i === 0 }]}
							href={s.href}
							aria-hidden={i === 0 ? undefined : 'true'}
							tabindex={i === 0 ? undefined : -1}
						>
							{s.image ? (
								<img src={s.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
							) : (
								<span class="car-texture" aria-hidden="true" />
							)}
							<span class="car-shade" aria-hidden="true" />
							<span class="car-eyebrow">{s.eyebrow}</span>
							{s.date && (
								<time class="car-date">
									<FormattedDate date={s.date} />
								</time>
							)}
							<span class="car-title">{s.title}</span>
						</a>
					))}
				</div>
			</div>

			{slides.length > 1 && (
				<>
					<button type="button" class="car-arrow prev" data-car-prev aria-label="上一張" set:html={icon('chevron-left')} />
					<button type="button" class="car-arrow next" data-car-next aria-label="下一張" set:html={icon('chevron-right')} />
					<span class="dots">
						{slides.map((_, i) => (
							<button type="button" class:list={['car-dot', { on: i === 0 }]} data-car-dot={i} aria-label={`第 ${i + 1} 張`} />
						))}
					</span>
				</>
			)}
		</div>
	)
}

<style>
	.carousel {
		position: relative;
		height: var(--wide-h);
		background: #0b0d10;
		border: 1px solid #222a31;
		overflow: hidden;
	}
	.car-viewport {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}
	.car-track {
		display: flex;
		height: 100%;
		transition: transform 0.5s ease;
	}
	.car-slide {
		position: relative;
		flex: none;
		width: 100%;
		height: 100%;
		display: block;
		overflow: hidden;
		text-decoration: none;
	}
	.car-slide img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.car-texture {
		position: absolute;
		inset: 0;
		background:
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.045) 0 56px, transparent 56px 64px),
			repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.045) 0 24px, transparent 24px 32px),
			#0b0d10;
	}
	.car-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(6, 8, 10, 0.05) 40%, rgba(6, 8, 10, 0.74));
	}
	.car-eyebrow {
		position: absolute;
		top: 0.55rem;
		left: 0.8rem;
		font-family: var(--font-narrow);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #f5c518;
	}
	.car-date {
		position: absolute;
		top: 0.55rem;
		right: 0.8rem;
		font-family: var(--font-terminal);
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.65);
	}
	.car-title {
		position: absolute;
		left: 0.8rem;
		right: 0.8rem;
		bottom: 0.55rem;
		color: #fff;
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.car-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		appearance: none;
		border-radius: 0;
		width: 2.1rem;
		height: 2.8rem;
		display: grid;
		place-items: center;
		background: rgba(6, 8, 10, 0.55);
		border: 1px solid #39434c;
		color: #fff;
		cursor: pointer;
		opacity: 0.35;
		transition: opacity 0.15s ease, background 0.15s ease;
		z-index: 2;
	}
	.carousel:hover .car-arrow,
	.carousel:focus-within .car-arrow {
		opacity: 1;
	}
	.car-arrow:hover {
		background: rgba(20, 26, 32, 0.85);
	}
	.car-arrow.prev {
		left: 0;
	}
	.car-arrow.next {
		right: 0;
	}
	.car-arrow :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
		fill: currentColor;
	}
	.dots {
		position: absolute;
		bottom: 0.6rem;
		right: 0.8rem;
		display: flex;
		gap: 5px;
		z-index: 2;
	}
	.car-dot {
		appearance: none;
		padding: 0;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		border: 0;
		background: #4a545c;
		cursor: pointer;
	}
	.car-dot.on {
		background: #fff;
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-carousel]');
	if (root) {
		const track = root.querySelector<HTMLElement>('.car-track')!;
		const slides = [...track.children] as HTMLElement[];
		const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-car-dot]')];
		let i = 0;
		let timer: number | undefined;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		function go(n: number) {
			i = (n + slides.length) % slides.length;
			track.style.transform = `translateX(-${i * 100}%)`;
			slides.forEach((s, k) => {
				s.classList.toggle('active', k === i);
				s.setAttribute('aria-hidden', k === i ? 'false' : 'true');
				s.tabIndex = k === i ? 0 : -1;
			});
			dots.forEach((d, k) => d.classList.toggle('on', k === i));
		}
		function play() {
			if (!reduced && slides.length > 1) timer = window.setInterval(() => go(i + 1), 6000);
		}
		function reset() {
			window.clearInterval(timer);
			play();
		}

		root.querySelector('[data-car-prev]')?.addEventListener('click', () => {
			go(i - 1);
			reset();
		});
		root.querySelector('[data-car-next]')?.addEventListener('click', () => {
			go(i + 1);
			reset();
		});
		dots.forEach((d, k) =>
			d.addEventListener('click', () => {
				go(k);
				reset();
			}),
		);
		root.addEventListener('mouseenter', () => window.clearInterval(timer));
		root.addEventListener('mouseleave', reset);

		go(0);
		play();
	}
</script>
