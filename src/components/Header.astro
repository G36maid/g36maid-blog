---
import { NAV_ITEMS } from '../consts';

const { cur } = Astro.props as { cur?: string };
const path = cur ?? Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---

<header class="site-header">
	<div class="shell header-row">
		<nav class="tabs" aria-label="主導覽">
			{
				NAV_ITEMS.map((item) => (
					<a
						class:list={['tab', { active: isActive(item.href) }]}
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
					>
						{item.label}
						{isActive(item.href) && <i class="dot" />}
					</a>
				))
			}
		</nav>
		<div class="header-tools">
			<button type="button" class="icon-btn" data-search-open aria-label="搜尋">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.5" />
					<path d="m15.5 15.5 5 5" />
				</svg>
			</button>
			<a class="icon-btn" href="/rss.xml" aria-label="RSS" title="RSS">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 11.5a7.5 7.5 0 0 1 7.5 7.5M5 6a13 13 0 0 1 13 13" />
					<circle cx="6.2" cy="17.8" r="1.5" fill="currentColor" stroke="none" />
				</svg>
			</a>
			<a class="icon-btn" href="/about/" aria-label="關於" title="About">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="8" r="3.6" />
					<path d="M4.5 20.5c1-4 4-6 7.5-6s6.5 2 7.5 6" />
				</svg>
			</a>
		</div>
	</div>
</header>
