---
import { NAV_ITEMS } from '../consts';
import { icon } from '../lib/icons';

const { cur } = Astro.props as { cur?: string };
const path = cur ?? Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---

<header class="site-header">
	<div class="shell header-row">
		<nav class="tabs" aria-label="主導覽">
			{
				NAV_ITEMS.map((item) => (
					<a
						class:list={['tab', { active: isActive(item.href) }]}
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
					>
						{item.label}
						{isActive(item.href) && <i class="dot" />}
					</a>
				))
			}
		</nav>
		<div class="header-tools">
			<a class="icon-btn" href="/rss.xml" aria-label="RSS" title="RSS" set:html={icon('rss')} />
			<a class="icon-btn" href="/about/" aria-label="關於" title="About" set:html={icon('person')} />
			<button type="button" class="icon-btn" data-search-open aria-label="搜尋" set:html={icon('search')} />
		</div>
	</div>
</header>
