---
import type { Post } from '../lib/content';
import { categoryLabel } from '../lib/content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}
const { post } = Astro.props;
const df = (d: Date) =>
	d.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<article class="news-card">
	<a class="nc-art" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
		<span class="code">{categoryLabel(post.data.category)}</span>
	</a>
	<div class="nc-body">
		<h3 class="nc-title">
			<a href={`/blog/${post.id}/`}>{post.data.title}</a>
		</h3>
		<div class="nc-row">
			<span class="tag-date">{df(post.data.pubDate)}</span>
			<span class="chip">{categoryLabel(post.data.category)}</span>
		</div>
		<p class="nc-desc">{post.data.description}</p>
		<div class="nc-meta">
			<span>{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
			<span class="nc-more">Read More →</span>
		</div>
	</div>
</article>
