---
import type { Post } from '../lib/content';
import { categoryLabel } from '../lib/content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<article class="tile-card">
	<div class="tc-top">
		<span class="tc-cat">{categoryLabel(post.data.category)}</span>
		<span class="tc-date"><FormattedDate date={post.data.pubDate} /></span>
	</div>
	<h3 class="tc-title">
		<a href={`/blog/${post.id}/`}>{post.data.title}</a>
	</h3>
	<p class="tc-desc">{post.data.description}</p>
	<div class="tc-meta">
		<span>{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
		<span class="tc-go" aria-hidden="true">▸ READ</span>
	</div>
</article>
