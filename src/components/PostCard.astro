---
import type { Post } from '../lib/content';
import { categoryLabel } from '../lib/content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<article class="op-card">
	<div class="op-card-top">
		<span class="chip">{categoryLabel(post.data.category)}</span>
		<span class="op-card-date"><FormattedDate date={post.data.pubDate} /></span>
	</div>
	<h3 class="op-card-title">
		<a href={`/blog/${post.id}/`}>{post.data.title}</a>
	</h3>
	<p class="op-card-desc">{post.data.description}</p>
	<div class="op-card-meta">
		<span>{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
		<span class="go" aria-hidden="true">DEPLOY →</span>
	</div>
</article>
