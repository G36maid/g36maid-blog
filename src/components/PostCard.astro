---
import type { Post } from '../lib/content';
import { categoryLabel } from '../lib/content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<article class="news-card">
	<a class="nc-art keyart" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">
		<span class="code">{categoryLabel(post.data.category)}</span>
	</a>
	<div class="nc-body">
		<h3 class="nc-title">
			<a href={`/blog/${post.id}/`}>{post.data.title}</a>
		</h3>
		<div class="nc-row">
			<span class="tag-date"><FormattedDate date={post.data.pubDate} /></span>
			<span class="chip">{categoryLabel(post.data.category)}</span>
		</div>
		<p class="nc-desc">{post.data.description}</p>
		<a class="btn-read" href={`/blog/${post.id}/`} style="margin-top: auto">Read More</a>
	</div>
</article>
