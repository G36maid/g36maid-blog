---
import Base from '../../layouts/Base.astro';
import { getTagCounts } from '../../lib/content';

const tagCounts = await getTagCounts();
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="TAGS — 標籤索引" description="所有標籤索引。">
	<div class="strip">
		<span class="s-tag">Signal Index</span>
		<span class="s-title">全部訊號節點，依文章數排序</span>
		<span class="s-end">{String(tags.length).padStart(3, '0')} NODES</span>
	</div>
	<div class="tag-cloud" style="margin-top: 1.5rem">
		{
			tags.map(([tag, count]) => (
				<a class="tag-chip" href={`/tags/${tag}/`}>
					#{tag} <span class="count">×{count}</span>
				</a>
			))
		}
	</div>
</Base>
