---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const about = (await getCollection('post', (entry) => entry.id === 'about'))[0];
let Content;
let description = '關於 g36maid 與這個 Wired 檔案室。';
if (about) {
	({ Content } = await render(about));
	description = about.data.description;
}
---

<Base title="ABOUT — 作戰簡報" description={description}>
	<header class="page-head">
		<div class="row">
			<h1 class="page-title">Operator <span class="accent">Dossier</span></h1>
			<span class="page-code">FILE 01 // CLEARANCE: PUBLIC</span>
		</div>
		<p class="page-sub">作戰人員檔案——g36maid 是誰、這個檔案室收容什麼。</p>
	</header>
	<article class="prose">
		{
			Content ? (
				<Content />
			) : (
				<>
					<p>
						<code>src/content/post/about.md</code> 尚未建立 — 建立該檔案即可自訂此頁內容。
					</p>
					<p>
						這裡是 <strong>g36maid</strong> 的技術檔案室，部署於 Cloudflare Workers。
						設計語言以虹彩六號的黑白藍戰術 UI 為底，帶一點 serial experiments lain 的 CRT
						終端氣氛。
					</p>
				</>
			)
		}
	</article>
</Base>
