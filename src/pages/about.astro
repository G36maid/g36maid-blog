---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const about = (await getCollection('post', (entry) => entry.id === 'about'))[0];
let Content;
let description = '關於 g36maid 與這個 Wired 檔案室。';
if (about) {
	({ Content } = await render(about));
	description = about.data.description;
}
---

<Base title="ABOUT — OPERATOR DOSSIER" description={description}>
	<section class="banner">
		<h1>Operator <span style="color: var(--red)">Dossier</span></h1>
		<div class="b-row">
			<span class="page-code">FILE 01 // CLEARANCE: PUBLIC</span>
		</div>
		<p class="page-sub">作戰人員檔案——g36maid 是誰、這個檔案室收容什麼。</p>
	</section>
	<article class="prose">
		{
			Content ? (
				<Content />
			) : (
				<>
					<p>
						<code>src/content/post/about.md</code> 尚未建立 — 建立該檔案即可自訂此頁內容。
					</p>
					<p>
						這裡是 <strong>g36maid</strong> 的技術檔案室，部署於 Cloudflare Workers。
						設計語言以虹彩六號官方網站的黑白紅戰術 UI 為底。
					</p>
				</>
			)
		}
	</article>
</Base>
