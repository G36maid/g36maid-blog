---
import Base from '../layouts/Base.astro';
---

<Base title="404 — CONNECTION REFUSED" description="頁面不存在於這一層。">
	<div style="text-align:center; padding: 4rem 0 2rem">
		<div class="telemetry">LAYER:404 // THE WIRED CANNOT FIND THIS ADDRESS</div>
		<div class="error-code glitch">404</div>
		<p style="color: var(--text-dim)">
			你要求的檔案不在這一層。<br />
			<span class="telemetry">"NO MATTER WHERE YOU GO, EVERYONE'S CONNECTED."</span>
		</p>
		<p style="margin-top:2rem">
			<a class="btn btn-primary" href="/">RETURN TO NODE</a>
		</p>
	</div>
</Base>
