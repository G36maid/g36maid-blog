---
import Base from '../layouts/Base.astro';
---

<Base title="404 — CONNECTION TERMINATED" description="頁面不存在於這一層。">
	<div class="notfound">
		<div class="telemetry">LAYER:404 // SIGNAL LOST</div>
		<div class="code">4<span class="ghost">0</span>4</div>
		<p class="msg">Connection terminated — 目標位址不存在於這一層</p>
		<p style="color: var(--text-dim)">
			<span class="telemetry">"NO MATTER WHERE YOU GO, EVERYONE'S CONNECTED."</span>
		</p>
		<p style="margin-top: 2rem">
			<a class="btn btn-primary" href="/">RETURN TO BASE</a>
		</p>
	</div>
</Base>
