---
import Base from '../layouts/Base.astro';
---

<Base title="404 — SIGNAL LOST" description="頁面不存在於這一層。">
	<div class="notfound">
		<div class="label">LAYER:404 // SIGNAL LOST</div>
		<div class="code">404</div>
		<p class="msg">Connection terminated — 目標位址不存在於這一層</p>
		<p class="sub">"NO MATTER WHERE YOU GO, EVERYONE'S CONNECTED."</p>
		<p style="margin-top: 2rem">
			<a class="btn-blue" style="display: inline-flex; padding: 0 2.5rem" href="/">RETURN TO BASE</a>
		</p>
	</div>
</Base>
