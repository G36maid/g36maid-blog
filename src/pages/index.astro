---
/**
 * Homepage — Rainbow Six Siege (Y4/Y5 era) main-menu layout study.
 * Original CSS/SVG recreation of the menu structure; no game assets —
 * the "operator art" is replaced by pure-CSS light / smoke atmosphere.
 * The blog itself plays the squad: playlists = site sections.
 *
 * This file is the layout shell only: atmosphere, top bar, strip and
 * the left-column widgets each live in components/home/*.
 */
import Base from '../layouts/Base.astro';
import Scene from '../components/home/Scene.astro';
import Topbar from '../components/home/Topbar.astro';
import TileGrid from '../components/home/TileGrid.astro';
import Carousel from '../components/home/Carousel.astro';
import QueueBar from '../components/home/QueueBar.astro';
import { getCollection } from 'astro:content';
import { getSortedPosts, getSortedNotes } from '../lib/content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { icon } from '../lib/icons';

const posts = await getSortedPosts();
const notes = await getSortedNotes();
const events = await getCollection('event');
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} chrome={false}>
	<div class="r6">
		<h1 class="sr-only">{SITE_TITLE}</h1>

		<Scene />

		<!-- ═ top bar ═ -->
		<Topbar />

		<!-- ═ left column ═ -->
		<main class="col">
			<p class="intro">
				<span>g36maid 的技術部落格——Linux、自架伺服器、程式開發, 開源新聞與隨筆。</span>
				<span>記錄實作、部署與日常摸索的第一手筆記。</span>
			</p>
			<a class="play" href="/blog/">
				<span class="play-ic" set:html={icon('bars')} />
				文章
			</a>

			<TileGrid />

			<Carousel events={events} posts={posts} />

			<QueueBar count={notes.length} />
		</main>

	</div>
</Base>

<style>
	/*
	 * Responsive model: components keep comfortable constant sizes;
	 * the layout adapts by position. Boxes clamp with vh so short
	 * windows squeeze heights gently; the column width only shrinks
	 * when the viewport edge pushes in. Below 960px width or 5/6
	 * aspect a stacked flow layout takes over.
	 *
	 * --gap/--tile-h/--wide-h/--queue-h are set here and inherited by
	 * the home/* child components through the DOM.
	 */
	.r6 {
		--gap: 12px;
		--tile-h: clamp(84px, 9.8vh, 106px);
		--wide-h: clamp(116px, 15.4vh, 166px);
		--queue-h: clamp(44px, 5.1vh, 55px);
		position: relative;
		min-height: 100vh;
		overflow: hidden;
		background: #0a0c0f;
		color: #dfe3e8;
		font-family: var(--font-narrow);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* ── left column ───────────────────────────────────────────────────── */
	.col {
		position: absolute;
		left: var(--inset);
		/* floats in the slack under the strip; matches the 16:9 design at 1080p */
		top: max(120px, calc(100vh - 720px));
		width: min(547px, calc(100vw - var(--inset) - 32px));
		display: flex;
		flex-direction: column;
		gap: var(--gap);
		z-index: 5;
	}
	.intro {
		margin: 0 0.2rem;
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: rgba(223, 227, 232, 0.6);
	}
	.intro span {
		display: block;
	}
	.play {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		height: var(--tile-h);
		background: #45b6e0;
		color: #fff;
		font-weight: 700;
		font-size: 26px;
		letter-spacing: 0.06em;
		text-decoration: none;
		transition: background 0.15s ease;
	}
	.play:hover {
		background: #63c6ec;
	}
	.play-ic {
		width: 28px;
		height: 28px;
		display: inline-grid;
		place-items: center;
	}
	.play-ic :global(svg) {
		width: 100%;
		height: 100%;
	}

	/* ── small / portrait screens: stack in flow ───────────────────────── */
	@media (max-width: 960px), (max-aspect-ratio: 5/6) {
		.r6 {
			display: flex;
			flex-direction: column;
		}
		.col {
			position: static;
			width: auto;
			max-width: 640px;
			margin: 18px 16px;
			gap: 12px;
		}
		.play {
			height: 84px;
			font-size: 22px;
		}
		.play-ic {
			width: 26px;
			height: 26px;
		}
	}
</style>
