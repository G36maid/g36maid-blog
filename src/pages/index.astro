---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getSortedPosts, getSortedNotes, getTagCounts } from '../lib/content';
import { LATEST_POSTS_COUNT } from '../consts';

const posts = await getSortedPosts();
const notes = await getSortedNotes();
const latest = posts[0];
const latestPosts = posts.slice(0, LATEST_POSTS_COUNT + 3);
const recentNotes = notes.slice(0, 4);
const tagCounts = await getTagCounts();
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const df = (d: Date) =>
	d.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Base>
	{
		latest && (
			<a class="op-strip" href={`/blog/${latest.id}/`}>
				<span class="op-tag">Latest Operation</span>
				<span class="op-title">{latest.data.title}</span>
				<span class="chev" aria-hidden="true">→</span>
				<time datetime={latest.data.pubDate.toISOString()}>{df(latest.data.pubDate)}</time>
			</a>
		)
	}

	<section class="hero-band">
		<div class="hero-main">
			<p class="hero-eyebrow">// WIRED ARCHIVE — TACTICAL BRIEFING</p>
			<h1 class="hero-title glitch">G36<span>MAID</span></h1>
			<p class="hero-tagline">Linux · Open Source · Self-Hosting · Homelab</p>
			<p class="hero-desc">
				分享 Linux 開源工具、自架伺服器、程式開發與技術隨筆的作戰檔案室——每一篇筆記，都是一場已完成的作戰紀錄。
			</p>
			<div class="hero-ctas">
				<a class="btn btn-primary" href="/blog/">Read All Logs</a>
				<a class="btn btn-ghost" href="/tags/">Tag Index</a>
			</div>
		</div>
		<aside class="hero-telemetry-panel" aria-label="站台狀態">
			<span>OPERATOR <b>g36maid</b></span>
			<span>LOGS <b>{String(posts.length).padStart(3, '0')}</b></span>
			<span>NOTES <b>{String(notes.length).padStart(3, '0')}</b></span>
			<span>TAGS <b>{String(tagCounts.size).padStart(3, '0')}</b></span>
			{latest && <span>LAST SORTIE <b>{df(latest.data.pubDate)}</b></span>}
			<span><span class="status-dot" aria-hidden="true"></span>STATUS <b class="ok">ONLINE</b></span>
			<div class="barcode" style="width: 9rem" aria-hidden="true"></div>
		</aside>
	</section>

	<section aria-labelledby="latest-ops">
		<div class="section-head">
			<h2 class="section-title" id="latest-ops">Latest Operations</h2>
			<span class="section-code">{String(posts.length).padStart(3, '0')} FILES</span>
			<a class="section-code" href="/blog/">ALL LOGS →</a>
		</div>
		<div class="card-grid">
			{latestPosts.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	{
		recentNotes.length > 0 && (
			<section aria-labelledby="field-notes">
				<div class="section-head">
					<h2 class="section-title" id="field-notes">Field Notes</h2>
					<span class="section-code">MEMOS // {String(notes.length).padStart(3, '0')}</span>
					<a class="section-code" href="/notes/">ALL NOTES →</a>
				</div>
				<div class="notes-strip">
					{recentNotes.map((note) => (
						<article class="note-row">
							<a class="note-title" href={`/notes/${note.id}/`}>
								{note.data.title}
							</a>
							<div class="note-meta">
								<FormattedDate date={note.data.pubDate} />
								<span>{note.data.tags.map((t) => `#${t}`).join(' ')}</span>
							</div>
						</article>
					))}
				</div>
			</section>
		)
	}

	{
		topTags.length > 0 && (
			<section aria-labelledby="signal-index">
				<div class="section-head">
					<h2 class="section-title" id="signal-index">Signal Index</h2>
					<span class="section-code">{String(tagCounts.size).padStart(3, '0')} NODES</span>
					<a class="section-code" href="/tags/">ALL TAGS →</a>
				</div>
				<div class="tag-cloud">
					{topTags.map(([tag, count]) => (
						<a class="tag-pill" href={`/tags/${tag}/`}>
							#{tag} <span class="count">×{count}</span>
						</a>
					))}
				</div>
			</section>
		)
	}
</Base>
