---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { categoryLabel, getSortedPosts } from '../../lib/content';

const posts = await getSortedPosts();

/** group by year, newest first */
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.pubDate.getFullYear();
	if (!byYear.has(y)) byYear.set(y, []);
	byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="LOGS — 全部文章" description="g36maid 的全部技術文章存檔，按年份排列。">
	<div class="strip">
		<span class="s-tag">Operations Archive</span>
		<span class="s-title">全部作戰紀錄，按年份歸檔</span>
		<span class="s-end">{String(posts.length).padStart(4, '0')} FILES</span>
	</div>

	{
		years.map((year) => (
			<section>
				<div class="year-head">
					<h2 class="year-title">{year}</h2>
					<div class="line" aria-hidden="true" />
					<span class="count">{String(byYear.get(year)!.length).padStart(3, '0')} OPS</span>
				</div>
				<ul class="log-list">
					{byYear.get(year)!.map((post) => (
						<li class="log-row">
							<span class="log-date"><FormattedDate date={post.data.pubDate} /></span>
							<a class="log-title" href={`/blog/${post.id}/`}>
								{post.data.title}
							</a>
							<span class="log-cat">{categoryLabel(post.data.category)}</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Base>
