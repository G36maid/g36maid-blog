---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getSortedNotes } from '../../lib/content';

const notes = await getSortedNotes();
---

<Base title="NOTES — 隨手筆記" description="短篇技術筆記與快速紀錄（TIL）。">
	<header class="page-head">
		<div class="row">
			<h1 class="page-title">Field <span class="accent">Notes</span></h1>
			<span class="page-code">{String(notes.length).padStart(3, '0')} MEMOS</span>
		</div>
		<p class="page-sub">短篇技術筆記與快速紀錄——偵察回報，隨手歸檔。</p>
	</header>

	<div class="notes-grid">
		{
			notes.map((note) => (
				<a class="note-bar" href={`/notes/${note.id}/`}>
					<span class="note-title">{note.data.title}</span>
					<span class="note-meta">
						<FormattedDate date={note.data.pubDate} />
						<span>{note.data.tags.map((t) => `#${t}`).join(' ')}</span>
					</span>
					<span class="chev" aria-hidden="true">→</span>
				</a>
			))
		}
	</div>
</Base>
