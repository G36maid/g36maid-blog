---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getSortedNotes } from '../../lib/content';

const notes = await getSortedNotes();
---

<Base title="NOTES — 隨手筆記" description="短篇技術筆記與快速紀錄（TIL）。">
	<div class="strip">
		<span class="s-tag">Field Notes</span>
		<span class="s-title">偵察回報，隨手歸檔</span>
		<span class="s-end">{String(notes.length).padStart(3, '0')} MEMOS</span>
	</div>

	<div class="notes-grid" style="margin-top: 1.5rem">
		{
			notes.map((note) => (
				<a class="note-card" href={`/notes/${note.id}/`}>
					<span class="note-title">{note.data.title}</span>
					<span class="note-meta">
						<FormattedDate date={note.data.pubDate} />
						<span>{note.data.tags.map((t) => `#${t}`).join(' ')}</span>
					</span>
				</a>
			))
		}
	</div>
</Base>
